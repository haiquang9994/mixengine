# Generated by MixEngine for {{ service.id }} from {{ package.name }} {{ package.version }}.
# Every edit here is overwritten on the next start. What you change is an override on the service.
{
	# Loopback whatever the service binds, and deliberately: this endpoint loads arbitrary
	# configuration into the running server, so it is a control channel and not something a site is
	# reached through. `bind_addr` is the second of those, and LAN sharing is about that one.
	admin 127.0.0.1:{{ settings.admin_port }}

	# The last configuration Caddy loaded is not a thing to remember. Without this it writes one to
	# the user's config directory and reads it back on the next start, which is a second source of
	# truth for a file MixEngine renders from the database — and a write outside MIXENGINE_HOME.
	persist_config off

	auto_https {{ settings.auto_https }}

	# **Caddy never installs a certificate authority on this machine. MixEngine owns that question.**
	#
	# Left alone, Caddy provisions a local CA of its own and installs its root into the user's trust
	# store the first time something needs one — silently, once per fresh data directory, and on
	# Windows that call blocks waiting for a consent nobody is there to give. Measured, not read
	# about: five `CN=Caddy Local Authority` roots were found in `CurrentUser\Root` on the machine
	# this repository is developed on, and a CI runner spent its whole readiness budget inside the
	# install with the server already answering nothing.
	#
	# It is the one thing this project refuses to do quietly. MixEngine has a CA of its own (T48), it
	# reaches the trust store through `mixengine-elevate` (T49a), and it does that once, for a root
	# the user was asked about. A supervised front end adding a second one is that whole design
	# undone by a default — and the more privilege the daemon happens to hold, the further the
	# install gets.
	#
	# **Two lines and not one, because the option alone does nothing.** `skip_install_trust` is
	# applied by the Caddyfile adapter to the certificate authorities it emits, and it emits none
	# unless a `pki` block names one — so on 2.11.4 the option by itself adapts to a configuration
	# with no `pki` app in it at all, and the CA that gets provisioned at run time is the implicit
	# one, with the installing default. `caddy adapt` says which of the two happened, and
	# `caddy.rs`' TLS test asks it rather than trusting this comment.
	skip_install_trust
	pki {
		ca local
	}

	# **The port the process binds, which is not always the port a browser asks for** — T43, D8.
	# The row keeps the answer port, because that is what a site is reached on and what LAN sharing
	# (T74) is about; macOS makes a front end listen on 8080 and 8443 behind a packet-filter
	# redirect, and `bound` is where that arrives as data rather than as a `#[cfg]` in this repo's
	# only cross-platform crate. On Windows and Linux it is the same number.
{%- if service.port %}
	http_port {{ service.port | bound }}
{%- endif %}
	https_port {{ settings.https_port | bound }}

	# Backticks and not quotes, on every path this file writes. A Caddyfile token in double quotes
	# processes `\"` and `\\` as escapes, so `C:\srv\caddy\` ends the string one character early and
	# the parse error names the line after it; inside backticks nothing is an escape and a Windows
	# path arrives as it was written.
	storage file_system `{{ paths.data }}`

	log {
		# To stderr, which is where it goes by default and where the supervisor is reading. Caddy
		# can write and roll its own files; MixEngine already does that for every service it runs
		# (`logs/services/{{ service.id }}/`), and two rotations of one stream is one of them
		# deleting what the other is serving to `mix service logs`.
		level {{ settings.log_level }}
	}
}

# One file per site, and no shared file anybody appends to: a site whose configuration is broken
# fails validation on its own rather than taking the other twelve down with it.
#
# The glob is relative to *this file*, which is what makes the staging directory work — the whole
# rendering is judged where it is staged, imports and all, and only then installed. A site file
# written anywhere else would be invisible to `caddy validate` and present at run time, which is the
# one arrangement that cannot be checked. Sites arrive in Phase 4; until then this matches nothing,
# which Caddy says as a warning and not as an error.
import sites/*.caddy

# One file per installed extension that declared a `[[recipe.front_end]]` for Caddy — roadmap task
# T81c. A second glob rather than a second name in the one above: the two directories have different
# lifetimes, `sites/` follows the `sites` table and this one follows `extensions`, and a sweep that
# could not tell them apart would be one table deleting the other's files.
#
# **A fragment here is judged before it is ever installed.** `extension.install` renders this whole
# file with the prospective fragment in it and runs `caddy validate` over the staged copy, so a
# fragment Caddy will not parse stops the install rather than this rendering.
import extensions/*.caddy

{{ extra }}
