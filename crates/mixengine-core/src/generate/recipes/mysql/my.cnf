# Generated by MixEngine for {{ service.id }} — do not edit.
#
# Everything here comes from the `services` row and from this instance's overrides. Edit those:
# `mix service set {{ service.id }} <key> <value>`. This file is rewritten on every start and any
# change made here is lost without ever being read.
#
# Every path is quoted and forward-slashed: MySQL's option parser treats `\` as an escape character
# and everything after an unquoted `#` as a comment, so a home under `C:\Users\Nguyen Hai Quang`
# breaks an unrendered path in two different ways at once.

[mysqld]
basedir = "{{ package.path | replace('\\', '/') }}"
datadir = "{{ paths.data | replace('\\', '/') }}"

# Stated rather than left to the default: a server started by a supervisor has nowhere else to put
# what it has to say, and on Windows it sends nothing to its own output at all.
log_error = "{{ paths.logs | replace('\\', '/') }}/mysql.err"

port = {{ service.port }}
bind-address = {{ service.bind }}

# **No `skip-name-resolve` here, although the MariaDB template two directories over sets it.**
# `mysqld --initialize-insecure` creates exactly one account, `root@localhost`, where MariaDB's
# installer also creates `root@127.0.0.1`. With the lookup off, the server compares the incoming
# address as a string — so a client connecting to 127.0.0.1 over TCP matches nothing and every one
# of them is refused by a server whose own log says it is ready for connections.

# The X Protocol is a second listener on 33060 that no port allocation ever handed out and no
# `services` row records, so two instances of MySQL 8 would collide on it however carefully their
# 3306s were chosen. `loose-` is what makes one line safe on all five lines: on 5.6 and 5.7, where
# the option does not exist, it is a warning rather than a refusal to start.
loose-mysqlx = OFF
{%- if paths.socket %}

# Under `run/` rather than beside the data directory: `sockaddr_un` caps a socket path at 103
# characters, and a server given a longer one aborts after it has started.
socket = "{{ paths.socket | replace('\\', '/') }}"
{%- endif %}

innodb_buffer_pool_size = {{ settings.innodb_buffer_pool_size }}
max_connections = {{ settings.max_connections }}

# **A development machine's defaults from here down, which are not the server's** — roadmap task
# **T73**. Every one of them exists in 5.6, the oldest series this product offers: `mysqld` refuses
# a whole file over one directive it does not know — the reason `mysqlx` above wears a `loose-` —
# so a younger line would stop the server rather than be ignored.

# MyISAM's key cache, allocated at startup and held whether or not one MyISAM table exists. A PHP
# application written this decade has no MyISAM tables at all, so this is memory a laptop pays for
# and never reads. 16M rather than 0, because parts of the `mysql` schema are still MyISAM on the
# older series published here.
key_buffer_size = 16M

# **Off, where MariaDB's build ships it off already.** It preallocates its tables at startup —
# hundreds of megabytes on a default 8.x, which is more than everything else on this page put
# together — and nothing in MixEngine reads a row of it. A user who wants to profile a query turns
# it back on through `extra` and restarts.
performance_schema = OFF

# **The log is flushed once a second rather than at every commit.** A power cut can lose about a
# second of committed transactions and cannot corrupt anything: `innodb_doublewrite` is untouched,
# and so is every other barrier that makes a torn page recoverable. What it buys is a migration or
# a seed — thousands of tiny transactions — not waiting for a disk on each one. Anybody who wants
# the server's own guarantee writes `innodb_flush_log_at_trx_commit = 1` into `extra`, which
# renders below this and wins.
innodb_flush_log_at_trx_commit = 2

character-set-server = {{ settings.character_set }}
collation-server = {{ settings.collation }}

{{ extra }}
