  "query": "SELECT p.name, p.version, p.install_path, p.installed_at, p.size_bytes, s.id AS service\n         FROM packages p\n         LEFT JOIN services s ON s.package_id = p.id\n         WHERE (? IS NULL OR p.name = ?)\n         ORDER BY p.name, p.version, s.id",
